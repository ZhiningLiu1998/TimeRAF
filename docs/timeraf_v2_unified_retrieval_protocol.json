  "status": "frozen_pre_execution",
  "amendments": [
    {
      "date": "2026-09-11",
      "scope": "adds the two fold-selection rungs v2_folded and v2_folded_conservative",
      "reason": "A four-cell EPF pipeline smoke test inside the development split showed that whole-window argmin over the enlarged candidate pool selects aggressive analogue-heavy candidates whose validation advantage does not transfer. Temporal two-fold minimax selection is the standard variance control for that failure and is added before any confirmatory cell is inspected. All four smoke cells are development cells.",
      "outcome_independence": "The rule scores every family identically, uses no test data, and is fixed before the development ladder runs."
    }
  ],
  "objective": "Extend the TimeRAF revision portfolio so one dial moves the retrieved correction continuously between the memory residual and the endpoint-aligned analogue future, and measure whether validation selection of that dial dominates both fixed objects.",
  "motivation": "In the accepted 585-cell fixed-forecast comparison the analogue-future control beat the residual object on PEMS (median worst-metric gain 11.70% against 9.16%) and on weak backbones, while the residual object was more reliable overall. Both are special cases of one additive correction, so the object should be selected per setting rather than fixed by design.",
  "unified_family": {
    "method_id": "residual_drift",
    "prediction": "base_q + alpha * (residual_correction_q + beta * ramp_h * drift_q)",
    "residual_correction": "existing shrinkage-weighted mean of memory residuals y_i - base_i over the retrieved neighbourhood",
    "drift": "sum_i w_i (base_i - x_i_last) + x_q_last - base_q",
    "identity_claims": [
      "beta = 0 reproduces the frozen historical_residual family exactly",
      "beta = 1, alpha = 1, ramp = flat, shrinkage = 0 reproduces the endpoint-aligned analogue mean over the same neighbourhood and weights",
      "the drift term reads only memory labels, memory forecasts and the query forecast, so the frozen no-lookahead check still applies unchanged"
    ],
    "ramps": {
      "flat": "w_h = 1",
      "linear": "w_h = (h + 1) / pred_len"
    }
  },
